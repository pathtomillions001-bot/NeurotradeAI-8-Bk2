<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false"><variables></variables><block type="trade_definition" id="nt0007" x="0" y="0"><statement name="TRADE_OPTIONS"><block type="trade_definition_market" id="hpmarket" deletable="false" movable="false"><field name="MARKET_LIST">synthetic_index</field><field name="SUBMARKET_LIST">random_index</field><field name="SYMBOL_LIST">R_50</field><next><block type="trade_definition_tradetype" id="hptradetype" deletable="false" movable="false"><field name="TRADETYPECAT_LIST">callput</field><field name="TRADETYPE_LIST">higherlower</field><next><block type="trade_definition_contracttype" id="hpcontracttype" deletable="false" movable="false"><field name="TYPE_LIST">both</field><next><block type="trade_definition_candleinterval" id="hpcandle" deletable="false" movable="false"><field name="CANDLEINTERVAL_LIST">60</field><next><block type="trade_definition_restartbuysell" id="hprestart" deletable="false" movable="false"><field name="TIME_MACHINE_ENABLED">FALSE</field><next><block type="trade_definition_restartonerror" id="hperror" deletable="false" movable="false"><field name="RESTARTONERROR">FALSE</field></block></next></block></next></block></next></block></next></block></next></block></statement><statement name="INITIALIZATION"><block type="notify" id="nt0006"><field name="NOTIFICATION_TYPE">info</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><block type="text" id="nt0001"><field name="TEXT">Hedge Pair Forge · Volatility 50 Index · Higher / Lower · USD 1.00 per leg / USD 2.00 pair exposure · target 1 tick(s) · up to 4999 ticks of Deriv deep history replayed as non-overlapping pairs · measured joint EV must clear 0.00% per combined stake (0% = break-even) · watching 1 market(s): R_50 · paired buys are non-atomic; Run in this Builder is required</field></block></value><next><block type="notify" id="nt0005"><field name="NOTIFICATION_TYPE">warn</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><block type="text" id="nt0002"><field name="TEXT">No profitability promise. Every hold is written to the Builder's Journal with its own arithmetic — paired sample count against the count the tape can actually produce, joint win/loss state counts, measured EV against the hurdle, entry timing. Hard blockers (too few paired samples, a tape in which every replayed pair lost both legs, an unstable estimate, entry timing) are never overridden; the patience valve is off, so a negative-EV hold is never forced. A one-win/one-loss pair never triggers recovery, but it never disarms an outstanding debt either.</field></block></value><next><block type="notify" id="nt0004"><field name="NOTIFICATION_TYPE">info</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><block type="text" id="nt0003"><field name="TEXT">Pair recovery arithmetic · markup 40% (this bot's own; the shared server default is 10%) · debt = BOTH lost premiums · per-leg stake = debt × (1 + 40%) ÷ (winning-leg payout − 1), capped at base × 2.43^step, max stake and half the balance, floored at 0.35 · projected at a 2.43× winning leg, one pair's debt of 2.00 sizes 1.96 per leg (3.92 at risk) · a split win nets 0.84 and leaves 1.16 owed, cleared by 6 consecutive split wins · recovery stays armed until the debt is 0 · the runtime re-sizes every pair from the poorer of the two LIVE leg payouts, not from this projection</field></block></value></block></next></block></next></block></statement><statement name="SUBMARKET"><block type="trade_definition_tradeoptions" id="hpoptions"><mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation><field name="DURATIONTYPE_LIST">t</field><field name="CURRENCY_LIST">USD</field><value name="DURATION"><shadow type="math_number_positive" id="hpduration"><field name="NUM">1</field></shadow></value><value name="AMOUNT"><shadow type="math_number_positive" id="hpstake"><field name="NUM">1</field></shadow></value></block></statement></block><block type="before_purchase" id="nt0009" x="0" y="900"><statement name="BEFOREPURCHASE_STACK"><block type="nt_hedge_pair_cycle" id="nt0008"><field name="FAMILY">HIGHER_LOWER</field><field name="DURATION">1</field><field name="UPPER_OFFSET">1</field><field name="LOWER_OFFSET">1</field><field name="WINDOW">4999</field><field name="MIN_SAMPLES">80</field><field name="EDGE_HURDLE">0</field><field name="RECOVERY_MULTIPLIER">2.43</field><field name="MAX_RECOVERY_STEPS">3</field><field name="MARKUP_PERCENT">40</field><field name="MAX_STAKE">500</field><field name="TAKE_PROFIT">10</field><field name="STOP_LOSS">5</field><field name="LOSS_BREAKER">6</field><field name="ENTRY_CONFIRMATIONS">2</field><field name="RECOVERY_CONFIRMATIONS">3</field><field name="MARKETS">R_50</field><field name="FORCE_ENTRY_AFTER">0</field></block></statement></block><block type="after_purchase" id="nt000b" x="0" y="1600"><statement name="AFTERPURCHASE_STACK"><block type="controls_if" id="nt000a"><value name="IF0"><block type="nt_hedge_pair_status" id="hpcontinuecheck"><field name="FIELD">continue</field></block></value><statement name="DO0"><block type="trade_again" id="hptradeagain"></block></statement></block></statement></block></xml>
